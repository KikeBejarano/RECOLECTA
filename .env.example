# ─────────────────────────────────────────────────────────────
# Supabase
# ─────────────────────────────────────────────────────────────

# URL pública del proyecto Supabase (expuesta al navegador)
NEXT_PUBLIC_SUPABASE_URL=

# Clave anónima pública de Supabase, usada por el cliente (expuesta al navegador)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 🔒 SOLO SERVIDOR — URL del proyecto Supabase para uso en el backend
SUPABASE_URL=

# 🔒 SOLO SERVIDOR — Clave service_role con permisos totales; NUNCA exponer al cliente
SUPABASE_SERVICE_ROLE_KEY=

# 🔒 SOLO SERVIDOR — Cadena de conexión del pooler de la base de datos (PgBouncer)
SUPABASE_DB_POOLER_URL=

# ─────────────────────────────────────────────────────────────
# Upstash Redis
# ─────────────────────────────────────────────────────────────

# URL REST del endpoint de Upstash Redis (rate limiting, caché)
UPSTASH_REDIS_REST_URL=

# 🔒 SOLO SERVIDOR — Token de autenticación para el endpoint REST de Upstash Redis
UPSTASH_REDIS_REST_TOKEN=

# ─────────────────────────────────────────────────────────────
# Nominatim (geocoding OpenStreetMap)
# ─────────────────────────────────────────────────────────────

# Identificador requerido por Nominatim en cada petición (User-Agent).
# Debe identificar la app y un contacto. Ej: "PuntosRecoleccion/1.0 (tu-email@ejemplo.com)"
NOMINATIM_USER_AGENT=

# ─────────────────────────────────────────────────────────────
# Cloudflare Turnstile (protección anti-bots)
# ─────────────────────────────────────────────────────────────

# Site key pública de Turnstile, usada por el widget en el navegador (expuesta al cliente)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# 🔒 SOLO SERVIDOR — Secret key de Turnstile para validar el token en el backend
TURNSTILE_SECRET_KEY=
